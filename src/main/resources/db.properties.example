# Database Connection Properties Example
# Copy this file to db.properties and set your local database credentials

# MySQL Database Settings
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/hospital_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=YOUR_USERNAME
db.password=YOUR_PASSWORD

# Embedded H2 Database Settings (Auto-fallback mode when MySQL is unavailable)
h2.driver=org.h2.Driver
h2.url=jdbc:h2:mem:hospital_db;DB_CLOSE_DELAY=-1;MODE=MySQL
h2.user=sa
h2.password=
